# Copy to .env for `netlify dev`. On Netlify, set these under Site configuration > Environment variables.
# Never commit a real key.
GROQ_API_KEY=

# Optional limits (defaults shown)
# /api/chat: requests per visitor per window, window length in minutes, and site-wide requests per UTC day
CHAT_RATE_LIMIT=60
CHAT_RATE_WINDOW_MIN=10
CHAT_DAILY_CAP=1000
# /api/rules (no LLM cost): requests per visitor per window and per UTC day
RULES_RATE_LIMIT=120
RULES_DAILY_CAP=2000
# Extra allowed browser origins, comma separated (the site URL and localhost are always allowed)
ALLOWED_ORIGINS=
