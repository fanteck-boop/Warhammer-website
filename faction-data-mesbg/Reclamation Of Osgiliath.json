  "additionalRules": [
    "A Reclamation of Osgiliath Army must include Boromir, Captain of the White Tower, who is always the Army's General."
  ],
  "specialRules": [
    {
      "name": "\"Remember today, little brother\"",
      "type": "",
      "text": "While Boromir and Faramir are within 3\" of each other, they may spend each other's Might, Will and Fate points as if they were their own."
    },
    {
      "name": "\"This city was once the jewel of our kingdom\"",
      "type": "",
      "text": "Friendly models gain the Mountain Dweller special rule."
    },
    {
      "name": "\"For Gondor!\"",
      "type": "",
      "text": "Once per game, at the start of any Fight Phase, Boromir can use this special rule so long as he is alive and on the battlefield. If he does, then friendly Gondor Warrior models within 6\" of Boromir gain a bonus of +1 To Wound when making Strikes until the end of the turn. This is treated as an Active ability belonging to Boromir."
    }
  ],
