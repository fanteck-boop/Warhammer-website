    "https://prancingponypub.ru/mesbg2024/good_army_list/defenders_of_helms_deep/"
  ],
  "additionalRules": [
    "A Defenders of Helm's Deep Army must include Théoden, King of Rohan, who is always the Army's General.",
    "Only a maximum of 33% of the models in this Army may have the Lothlórien keyword."
  ],
  "specialRules": [
    {
      "name": "Allies 'til the End",
      "type": "",
      "text": "Haldir treats both Aragorn and Théoden as a banner with a range of 6\". Additionally, whilst within 6\" of either Aragorn or Théoden, Haldir automatically passes all Courage Tests and may re-roll failed To Wound Rolls when making Strikes."
    },
    {
      "name": "\"Fall Back to the Keep!\"",
      "type": "",
      "text": "If this Army is Broken, friendly Warrior models gain a bonus of +1 to any Courage Tests they are required to take. Additionally, if this Army is Broken, friendly Warrior models within 6\" of Théoden may re-roll failed Courage Tests."
    },
    {
      "name": "\"Give them a Volley\"",
      "type": "",
      "text": "Friendly models increase the range of their shooting attacks by 6\", provided they have not moved that turn. This special rule does not apply to throwing weapons."
    }
  ],
