  "additionalRules": [
    "An Arnor Army must always contain Arvedui, who is always the Army's General.",
    "Friendly Rangers of the North gain the Arnor keyword."
  ],
  "specialRules": [
    {
      "name": "Defend the King",
      "type": "",
      "text": "Whilst within 6\" of Arvedui, friendly Arnor models automatically pass any Courage Tests they are required to take."
    },
    {
      "name": "Power of the Seer",
      "type": "",
      "text": "Friendly Arnor Hero models receive a bonus of +1 when rolling for Malbeth's Gift of Foresight special rule."
    },
    {
      "name": "Seeing Stones",
      "type": "ACTIVE",
      "text": "Once per game, during the Priority Phase but before the roll for Priority, so long as Arvedui is alive and on the battlefield, his controlling player automatically wins the roll to choose who has Priority for that turn. If both sides have a similar rule and both wish to use it, players roll off as normal."
    }
  ],
