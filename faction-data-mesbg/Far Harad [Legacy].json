  "additionalRules": [
    "A Far Harad Army must always contain a Mahud King, who is always the Army's General."
  ],
  "specialRules": [
    {
      "name": "Warrior Pride",
      "type": "",
      "text": "Mahud Warrior models within 6\" of a friendly Mahud Hero model that is Engaged in Combat automatically pass all Courage Tests they are required to take."
    },
    {
      "name": "Revel in Death",
      "type": "",
      "text": "If your General slays an enemy Hero model in Combat, then until the end of the turn friendly Mahud Warrior models within 6\" of your General gain a bonus of +1 to their Fight Value."
    },
    {
      "name": "Battle Frenzy",
      "type": "",
      "text": "Whenever a friendly Mahud model suffers a Wound, roll a D6. On the roll of natural 6, the Wound is ignored."
    }
  ],
